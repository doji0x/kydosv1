{
  "name": "Token",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "telegram": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "creator_handle": {
      "type": "string"
    },
    "creator_tax_bps": {
      "type": "number",
      "default": 0
    },
    "buyback_enabled": {
      "type": "boolean",
      "default": true
    },
    "chain_id": {
      "type": "number",
      "default": 46630
    },
    "token_address": {
      "type": "string"
    },
    "curve_address": {
      "type": "string"
    },
    "uniswap_pair": {
      "type": "string",
      "description": "V4 PoolId after graduation"
    },
    "v4_position_id": {
      "type": "string"
    },
    "hook_address": {
      "type": "string"
    },
    "locker_address": {
      "type": "string"
    },
    "tx_hash": {
      "type": "string"
    },
    "block_number": {
      "type": "number"
    },
    "total_supply": {
      "type": "number",
      "default": 1000000000
    },
    "reserve": {
      "type": "number",
      "description": "Tracked native ETH reserve",
      "default": 0
    },
    "tokens_sold": {
      "type": "number",
      "default": 0
    },
    "market_cap": {
      "type": "number",
      "description": "Market cap in native ETH",
      "default": 0
    },
    "graduation_target": {
      "type": "number",
      "description": "Tracked ETH needed to graduate",
      "default": 85
    },
    "graduation_phase": {
      "type": "string",
      "enum": [
        "curve",
        "swept",
        "seeded"
      ],
      "default": "curve"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "graduated"
      ],
      "default": "live"
    },
    "trade_count": {
      "type": "number",
      "default": 0
    },
    "holder_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "ticker"
  ]
}