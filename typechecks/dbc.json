{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "../solana/dbc/*.mjs",
    "../solana/dbc/*.d.ts"
  ],
  "exclude": [
    "../solana/dbc/node_modules",
    "../solana/dbc/*.test.mjs"
  ]
}
