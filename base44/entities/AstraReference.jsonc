{
  "name": "AstraReference",
  "type": "object",
  "description": "Admin-curated external protocol documentation for Astra specialists.",
  "properties": {
    "uid": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_repo": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_uri": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "uid",
    "title",
    "summary",
    "file_uri",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}