{
  "description": "Samples Jupiter prices once per minute for tracked Solana mints, in five-minute collection cycles.",
  "name": "Sample Jupiter Prices",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sample_jupiter_prices",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sample_one": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollJupiterPrices",
            "args": {}
          },
          "then": "wait_one",
          "x-base44": {
            "title": "Sample minute one"
          }
        }
      },
      {
        "wait_one": {
          "wait": "${ .sample_one.wait }",
          "then": "sample_two",
          "x-base44": {
            "title": "Wait for next minute"
          }
        }
      },
      {
        "sample_two": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollJupiterPrices",
            "args": {}
          },
          "then": "wait_two",
          "x-base44": {
            "title": "Sample minute two"
          }
        }
      },
      {
        "wait_two": {
          "wait": "${ .sample_two.wait }",
          "then": "sample_three",
          "x-base44": {
            "title": "Wait for next minute"
          }
        }
      },
      {
        "sample_three": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollJupiterPrices",
            "args": {}
          },
          "then": "wait_three",
          "x-base44": {
            "title": "Sample minute three"
          }
        }
      },
      {
        "wait_three": {
          "wait": "${ .sample_three.wait }",
          "then": "sample_four",
          "x-base44": {
            "title": "Wait for next minute"
          }
        }
      },
      {
        "sample_four": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollJupiterPrices",
            "args": {}
          },
          "then": "wait_four",
          "x-base44": {
            "title": "Sample minute four"
          }
        }
      },
      {
        "wait_four": {
          "wait": "${ .sample_four.wait }",
          "then": "sample_five",
          "x-base44": {
            "title": "Wait for next minute"
          }
        }
      },
      {
        "sample_five": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollJupiterPrices",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sample minute five"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}