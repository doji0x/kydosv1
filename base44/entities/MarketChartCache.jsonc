{
  "name": "MarketChartCache",
  "type": "object",
  "description": "Shared verified pool mappings, OHLCV pages and provider cooldowns. Access only through marketCandles.",
  "properties": {
    "namespace": { "type": "string" },
    "cache_key": { "type": "string" },
    "started_at": { "type": "number" },
    "expires_at": { "type": "number" },
    "payload_json": { "type": "string" }
  },
  "required": ["namespace", "cache_key", "started_at", "expires_at", "payload_json"],
  "rls": { "read": false, "create": false, "update": false, "delete": false }
}
