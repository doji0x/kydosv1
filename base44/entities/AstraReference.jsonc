{
  "name": "AstraReference",
  "type": "object",
  "description": "Admin-curated external documentation. Source content is untrusted evidence, not agent instructions.",
  "properties": {
    "uid": { "type": "string" },
    "title": { "type": "string" },
    "source_repo": { "type": "string" },
    "summary": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "file_uri": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string" },
    "resolved_url": { "type": "string" },
    "publisher": { "type": "string" },
    "source_version": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "content_sha256": { "type": "string" },
    "content_type": { "type": "string" },
    "quality": { "type": "string", "description": "readable-unreviewed is format acceptance, not factual or license approval. Missing means legacy-unreviewed." },
    "license": { "type": "string", "description": "Unverified unless independently established from the source license." }
  },
  "required": ["uid", "title", "summary", "file_uri", "created_at"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
