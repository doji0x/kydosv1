{
  "name": "AstraMessage",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "activity"
      ],
      "default": "user"
    },
    "content": {
      "type": "string"
    },
    "turn": {
      "type": "number"
    },
    "toolName": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "durationMs": {
      "type": "number"
    },
    "repo": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "specialistRole": {
      "type": "string"
    },
    "activityType": {
      "type": "string",
      "enum": [
        "specialist_start",
        "reasoning",
        "tool",
        "report",
        "specialist_complete",
        "specialist_failed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "detailType": {
      "type": "string",
      "enum": [
        "file",
        "tree",
        "reference",
        "none"
      ]
    },
    "detailRef": {
      "type": "string"
    }
  },
  "required": [
    "conversationId",
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}