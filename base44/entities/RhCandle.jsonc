{
  "name": "RhCandle",
  "type": "object",
  "description": "OHLCV bar for a tracked token at one interval, rolled up from RhTrade records.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Dedupe key: <token>-<interval>-<bucket_start>"
    },
    "token_address": {
      "type": "string"
    },
    "interval": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ]
    },
    "bucket_start": {
      "type": "number",
      "description": "Epoch ms of the bar's opening boundary"
    },
    "open": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "close": {
      "type": "number"
    },
    "volume_usd": {
      "type": "number",
      "default": 0
    },
    "trades": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "uid",
    "token_address",
    "interval",
    "bucket_start"
  ]
}