{
  "name": "RhTrade",
  "type": "object",
  "description": "A normalized Robinhood Chain swap with canonical verification status.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "Dedupe key: <tx_hash>-<log_index>"
    },
    "chain_id": {
      "type": "number",
      "default": 46630
    },
    "token_address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "enum": [
        "uniswap_v2",
        "uniswap_v3",
        "uniswap_v4",
        "rialto",
        "kydos_curve"
      ]
    },
    "pool": {
      "type": "string"
    },
    "trader": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "token_amount": {
      "type": "number"
    },
    "quote_amount": {
      "type": "number"
    },
    "price_quote": {
      "type": "number"
    },
    "price_usd": {
      "type": "number"
    },
    "volume_usd": {
      "type": "number"
    },
    "sqrt_price_x96": {
      "type": "string"
    },
    "tick": {
      "type": "number"
    },
    "block_number": {
      "type": "number"
    },
    "block_time": {
      "type": "number"
    },
    "tx_hash": {
      "type": "string"
    },
    "log_index": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "SUSPECT",
        "QUARANTINED",
        "REPAIRED",
        "INVALID"
      ],
      "default": "VERIFIED"
    },
    "repair_of": {
      "type": "string"
    },
    "repair_reason": {
      "type": "string"
    },
    "verification_method": {
      "type": "string"
    }
  },
  "required": [
    "uid",
    "chain_id",
    "token_address",
    "venue",
    "side"
  ]
}