{
  "name": "RhPool",
  "type": "object",
  "description": "A discovered liquidity pool with canonical trust controls.",
  "properties": {
    "address": {
      "type": "string"
    },
    "token_address": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "enum": [
        "uniswap_v2",
        "uniswap_v3",
        "rialto"
      ]
    },
    "token0": {
      "type": "string"
    },
    "token1": {
      "type": "string"
    },
    "base_is_token0": {
      "type": "boolean"
    },
    "quote_address": {
      "type": "string"
    },
    "quote_symbol": {
      "type": "string"
    },
    "quote_decimals": {
      "type": "number",
      "default": 18
    },
    "base_decimals": {
      "type": "number",
      "default": 18
    },
    "fee": {
      "type": "number"
    },
    "reserve_base": {
      "type": "number"
    },
    "reserve_quote": {
      "type": "number"
    },
    "liquidity_usd": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "discovered_at": {
      "type": "number"
    },
    "trust_status": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "PROBATION",
        "SUSPENDED"
      ],
      "default": "TRUSTED"
    },
    "suspended_until": {
      "type": "number"
    },
    "suspension_reason": {
      "type": "string"
    }
  },
  "required": [
    "address",
    "token_address",
    "venue"
  ]
}