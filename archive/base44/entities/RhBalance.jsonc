{
  "name": "RhBalance",
  "type": "object",
  "description": "Per-wallet balance of a tracked token, accumulated from indexed Transfer logs.",
  "properties": {
    "uid": {
      "type": "string",
      "description": "<chain>-<token>-<wallet>"
    },
    "chain_id": {
      "type": "number",
      "default": 46630
    },
    "token_address": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "description": "Human-scaled balance"
    },
    "is_pool": {
      "type": "boolean",
      "default": false
    },
    "updated_block": {
      "type": "number"
    }
  },
  "required": [
    "uid",
    "chain_id",
    "token_address",
    "wallet"
  ]
}