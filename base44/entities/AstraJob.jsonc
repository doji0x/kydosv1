{
  "name": "AstraJob",
  "type": "object",
  "description": "A durable Astra builder or auditor assignment with bounded retries and resumable execution checkpoints.",
  "properties": {
    "jobUid": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "batchId": {
      "type": "string"
    },
    "milestoneId": {
      "type": "string"
    },
    "turn": {
      "type": "number"
    },
    "role": {
      "type": "string",
      "enum": [
        "builder",
        "audit",
        "architect",
        "logic",
        "functions",
        "integration",
        "documentation"
      ],
      "description": "Live roles are builder and audit; legacy values are retained for historical jobs."
    },
    "scope": {
      "type": "string"
    },
    "job": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "blocked",
        "failed",
        "completed",
        "cancelled"
      ],
      "default": "queued"
    },
    "position": {
      "type": "number"
    },
    "attempt": {
      "type": "number",
      "default": 1
    },
    "maxAttempts": {
      "type": "number",
      "default": 3
    },
    "runToken": {
      "type": "string"
    },
    "auditDecisionId": {
      "type": "string"
    },
    "resumeFromJobId": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "default": "astra/latest"
    },
    "baseCommitSha": {
      "type": "string"
    },
    "headCommitSha": {
      "type": "string"
    },
    "queuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeatAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    },
    "resultRecordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentStep": {
      "type": "number",
      "default": 0
    },
    "currentStepLabel": {
      "type": "string"
    },
    "lastCheckpoint": {
      "type": "string"
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "result"
        ]
      }
    },
    "blocker": {
      "type": "string"
    },
    "nextStep": {
      "type": "string"
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "report": {
      "type": "string"
    },
    "durationMs": {
      "type": "number"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "jobUid",
    "requestId",
    "conversationId",
    "batchId",
    "role",
    "scope",
    "job",
    "status",
    "position",
    "runToken",
    "branch",
    "queuedAt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}