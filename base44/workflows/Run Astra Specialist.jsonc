{
  "name": "Run Astra Specialist",
  "description": "Runs queued Astra specialists independently from the live manager chat.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AstraJob",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"queued\" and (.trigger.old_data.status // \"\") != \"queued\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_astra_specialist",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_specialist": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "astraWorker",
            "args": {
              "jobId": "${ .trigger.entity_id }",
              "runToken": "${ .trigger.data.runToken }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Astra specialist",
            "description": "Process queued assignment"
          }
        }
      }
    ]
  }
}