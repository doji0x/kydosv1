{
  "name": "RhToken",
  "type": "object",
  "description": "Canonical market stats and publication health for a tracked token.",
  "properties": {
    "address": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "decimals": {
      "type": "number",
      "default": 18
    },
    "total_supply": {
      "type": "number"
    },
    "icon_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "telegram": {
      "type": "string"
    },
    "tracked": {
      "type": "boolean",
      "default": true
    },
    "price_quote": {
      "type": "number"
    },
    "price_usd": {
      "type": "number"
    },
    "market_cap": {
      "type": "number"
    },
    "fdv": {
      "type": "number"
    },
    "volume_24h": {
      "type": "number"
    },
    "liquidity_usd": {
      "type": "number"
    },
    "change_1h": {
      "type": "number"
    },
    "change_6h": {
      "type": "number"
    },
    "change_24h": {
      "type": "number"
    },
    "buys_24h": {
      "type": "number",
      "default": 0
    },
    "sells_24h": {
      "type": "number",
      "default": 0
    },
    "trades_24h": {
      "type": "number",
      "default": 0
    },
    "holder_count": {
      "type": "number",
      "default": 0
    },
    "pool_count": {
      "type": "number",
      "default": 0
    },
    "last_indexed_block": {
      "type": "number",
      "default": 0
    },
    "stats_updated_at": {
      "type": "number"
    },
    "pools_synced_at": {
      "type": "number"
    },
    "market_status": {
      "type": "string",
      "enum": [
        "OK",
        "DEGRADED",
        "UNAVAILABLE"
      ],
      "default": "OK"
    },
    "market_status_reason": {
      "type": "string"
    }
  },
  "required": [
    "address"
  ]
}